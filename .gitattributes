* text=auto
*.py text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.pdf binary
*.zip binary

# Keep the official template bytes unchanged across Windows/Linux checkouts.
paper/aamas.cls -text -whitespace
paper/ACM-Reference-Format.bst -text -whitespace

# Preserve original localized prompt literals, including their inherited spaces.
agent_as_a_judge/module/prompt/*.py whitespace=-trailing-space
